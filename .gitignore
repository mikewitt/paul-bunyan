__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
# Parallel coverage writes one file per process before combining them; an
# interrupted run leaves them behind.
.coverage.*
coverage.xml
htmlcov/
dist/
build/

# Agent worktrees are real git worktrees living inside the repo; staging them
# would embed one repository in another. Tool scratch, never committed.
.claude/worktrees/

# Benchmark baselines are absolute nanoseconds, which belong to one machine —
# `--compare` refuses a baseline whose CPU fingerprint differs, so a committed
# one would be useless to everyone but its author. Record your own.
benchmarks/*.local.json
# Recorded locally by scripts/record_demo.py; CI publishes the canonical one
# to the demo-assets branch, so a checkout never carries the binary.
docs/demo-*.gif
